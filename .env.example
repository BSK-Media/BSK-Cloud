# Skopiuj do pliku .env i uzupełnij. Plik .env NIE trafia do repozytorium.

# Domena i adres publiczny
BSK_DOMAIN=cloud.bskmedia.pl
BSK_PUBLIC_URL=https://cloud.bskmedia.pl
# Adres portalu w sieci biurowej — BSK Backup w biurze wysyła tędy (szybciej, bez Cloudflare)
BSK_LAN_URL=http://192.168.50.42:8090
BSK_SITE_NAME=BSK Media Cloud

# Folder na DUŻYM dysku (HDD) na pliki klientów, kopie pracowników i linki do pobrania
BSK_DATA_FOLDER=/volume2/bsk-dane
# Folder na SZYBKIM dysku (SSD) na bazę danych portalu
BSK_DB_FOLDER=/volume1/bsk-cloud/baza
# Folder na drugim dysku na codzienną kopię bazy i plików klientów (np. SSD 1 TB)
BSK_BACKUP_FOLDER=/volume2/bsk-kopie
# UID/GID właściciela tych folderów (sprawdzisz przez SSH: ls -ln /volume1 /volume2)
PUID=1000
PGID=10

# Losowy sekret do podpisywania sesji — wygeneruj: openssl rand -hex 32
BSK_SECRET_KEY=

# Pierwsze konto administratora (tworzone tylko przy pierwszym starcie, gdy nie ma admina).
# Po pierwszym zalogowaniu usuń hasło z tego pliku.
BSK_ADMIN_USERNAME=admin
BSK_ADMIN_PASSWORD=

# Ciasteczka tylko po HTTPS (zostaw true; false tylko do testów po http w sieci lokalnej)
BSK_COOKIE_SECURE=true
BSK_SESSION_HOURS=12

# Limity
BSK_MAX_UPLOAD_MB=51200
BSK_MAX_BACKUP_FILE_MB=20480
BSK_BACKUP_KEEP_VERSIONS=10
# Domyślny limit miejsca dla nowego klienta w MB (0 = bez limitu; można zmienić dla każdego klienta)
BSK_DEFAULT_QUOTA_MB=0

# Powiadomienia e-mail (Hostinger: smtp.hostinger.com, port 465; login = pełny adres skrzynki)
# Do admina: nowe pliki i wiadomości od klientów. Do klientów: Twoje odpowiedzi i nowe pliki.
BSK_SMTP_HOST=
BSK_SMTP_PORT=465
BSK_SMTP_USER=
BSK_SMTP_PASSWORD=
BSK_SMTP_FROM=
BSK_NOTIFY_EMAIL=

# Edycja dokumentów online (profil "office") — publiczny adres serwera dokumentów i wspólny sekret
BSK_OFFICE_URL=https://cloud.bskmedia.pl/office
BSK_OFFICE_SECRET=
BSK_OFFICE_FOLDER=/volume1/bsk-cloud/office

# Tylko przy profilu "tunnel" (Cloudflare Tunnel)
CLOUDFLARE_TUNNEL_TOKEN=
